# DayShield Backend Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env to git.

# Gemini AI Configuration (Google AI Studio / Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth 2.0 (Calendar Read + Gmail Drafts Only - No billing required)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# Database (SQLite by default)
DATABASE_URL=sqlite:///./dayshield.db

# Application Settings
APP_ENV=development
SIMULATION_MODE=true
USER_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
SECRET_KEY=change-this-to-a-random-secret-for-approval-tokens
